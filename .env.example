# Google Gemini / GenAI API Key for Gemma 4 Insights
# Optional: The application operates in high-fidelity deterministic rule-based demo mode if this is omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemma 4 Model Identifier (from official google-genai SDK docs)
# Options: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# SQLite Database Path (Single-node architecture with WAL mode and BEGIN IMMEDIATE)
ANNRAKSHAK_DB_PATH=annrakshak.db

# Demo Mode (default false). When true, 1-click test login buttons appear on authentication screen.
DEMO_MODE=false
